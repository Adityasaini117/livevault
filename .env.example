# LifeVault AI Provider Configuration
# Choose "gemini" (default, free tier available) or "bedrock" (AWS)
AI_PROVIDER=gemini

# Google Gemini Configuration
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# AWS Bedrock Configuration (used when AI_PROVIDER=bedrock)
AWS_REGION=ap-southeast-2
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# AWS credentials can be placed here or in standard AWS CLI config/environment
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# LifeVault Storage Backend Configuration
# Choose "sqlite" (default local file) or "dynamodb" (AWS single-table)
STORAGE_BACKEND=sqlite
DYNAMODB_TABLE=lifevault-records

# LifeVault API Token for simple access protection (optional for local testing)
LIFEVAULT_API_TOKEN=your_token_here
